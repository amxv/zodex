---
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";
import "../styles/landing.css";

const localFeatures = [
  {
    index: "01",
    marker: "HOST",
    title: "Your real environment",
    body: "ChatGPT works as your logged-in Linux, macOS, or Windows user with the shell, Git, language toolchains, credentials, and files you already use."
  },
  {
    index: "02",
    marker: "∞",
    title: "Many Agents, one runtime",
    body: "Several ChatGPT conversations can work concurrently across repositories and worktrees without starting another daemon or tunnel."
  },
  {
    index: "03",
    marker: "LIVE",
    title: "See every tool call",
    body: "Liveboard gives each Agent an independent timeline of commands, output, file diffs, stdin, process state, and recent workdirs."
  },
  {
    index: "04",
    marker: "HIST",
    title: "History survives the session",
    body: "Execution evidence stays available after Liveboard closes and after Local stops, with compact history and exact audit views when you need them."
  },
  {
    index: "05",
    marker: "TTL",
    title: "Access has a lifecycle",
    body: "The menu app can always be there while Local stays off. Start access only when you want it, optionally give it a TTL, and stop it cleanly."
  },
  {
    index: "06",
    marker: "⌘",
    title: "No terminal for daily use",
    body: "The native menu app launches at login by default without starting Local. Pick a folder, start or stop Zodex, open Liveboard, and upgrade from the menu bar."
  }
];

const tools = [
  {
    index: "01",
    name: "exec_command",
    verb: "Run",
    body: "Run a shell command in an explicit absolute workdir. Builds, tests, Git, dev servers, REPLs, and ordinary command-line workflows stay ordinary."
  },
  {
    index: "02",
    name: "write_stdin",
    verb: "Continue",
    body: "Poll a running process, send input, or stop it. Long-running work keeps a stable session instead of becoming fire-and-forget subprocesses."
  },
  {
    index: "03",
    name: "apply_patch",
    verb: "Edit",
    body: "Apply the Codex-style patch format GPT models already know. Zodex does not make the model learn a new editing abstraction first."
  }
];

const modes = [
  {
    index: "L",
    title: "Local",
    subtitle: "Trusted Linux, macOS, or Windows host",
    href: "/docs/local",
    body: "Direct trusted-host execution through an OpenAI Secure MCP Tunnel. Your machine, your developer environment, your credentials.",
    facts: ["Secure MCP Tunnel", "explicit start / stop", "optional runtime TTL", "Liveboard + durable history"]
  },
  {
    index: "S",
    title: "Sprite",
    subtitle: "Wake-on-demand remote Linux",
    href: "/docs/sprite",
    body: "The same three-tool model interface on a remote Linux workspace, behind Zodex's Cloudflare Worker and an isolated GitHub write boundary.",
    facts: ["automatic wake / sleep", "remote Linux workspace", "review-first PRs", "push grants + scoped YOLO"]
  }
];

const docsLinks = [
  ["01", "Local", "/docs/local", "Setup, daily use, Liveboard, history, configuration, and troubleshooting."],
  ["02", "Sprite", "/docs/sprite", "Remote Linux setup, connection, GitHub permissions, and operations."],
  ["03", "Architecture", "/docs/reference/architecture", "How the two execution modes share a runtime core without sharing a trust model."],
  ["04", "MCP tools", "/docs/reference/tools", "The exact three-tool contract, process sessions, and patch behavior."],
  ["05", "Observability API", "/docs/local/observability-api", "Build another read-only viewer on the same HTTP/SSE evidence model as Liveboard."],
  ["06", "Source", "https://github.com/amxv/zodex", "Read the Rust runtime, SolidJS Liveboard, Swift menu-bar app, docs, and Worker source."]
];
---

<BaseLayout
  title={`${siteConfig.name} | ${siteConfig.strapline}`}
  description={siteConfig.description}
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <main class="zodex-home">
    <section class="z-hero shell">
      <div class="z-hero__eyebrow reveal reveal--1">
        <span class="live-dot" aria-hidden="true"></span>
        Zodex Local
        <span class="z-hero__eyebrow-rule" aria-hidden="true"></span>
        ChatGPT × your machine
      </div>

      <div class="z-hero__copy">
        <p class="z-overline reveal reveal--2">A real terminal on a real machine</p>
        <h1 class="reveal reveal--3">Give ChatGPT<br />your <em>machine.</em></h1>
        <p class="z-hero__lede reveal reveal--4">
          Zodex gives ChatGPT the command, stdin, and patch primitives coding agents already know—directly on your trusted Linux, macOS, or Windows machine, through an OpenAI Secure MCP Tunnel.
        </p>
        <div class="z-hero__actions reveal reveal--5">
          <a class="z-button z-button--signal" href="/docs/local">Set up Local <span aria-hidden="true">↗</span></a>
          <a class="z-button z-button--quiet" href="#quick-start">How it works <span aria-hidden="true">↓</span></a>
          <a class="z-button z-button--quiet" href="https://github.com/amxv/zodex" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="z-hero__proof reveal reveal--6" aria-label="Core Zodex Local facts">
        <div><strong>03</strong><span>MCP tools</span></div>
        <div><strong>⌘</strong><span>menu-bar control</span></div>
        <div><strong>∞</strong><span>ChatGPT Agents</span></div>
        <div><strong>LIVE</strong><span>observable</span></div>
      </div>

      <figure class="product-shot reveal reveal--6">
        <div class="product-shot__bar">
          <span>ZDX / LOCAL</span>
          <span class="product-shot__status"><i aria-hidden="true"></i> MCP ready</span>
          <span>CHATGPT + LIVEBOARD</span>
        </div>
        <img
          src="/images/zodex-local-liveboard.png"
          alt="ChatGPT coding on a Mac through Zodex Local beside the Zodex Liveboard showing commands and file changes"
          width="2880"
          height="1480"
          loading="eager"
          decoding="async"
        />
        <figcaption>
          <span>One ChatGPT conversation is one Zodex Agent.</span>
          <span>Commands, output, diffs, and process state stay visible beside the work.</span>
        </figcaption>
      </figure>
    </section>

    <div class="signal-strip" aria-hidden="true">
      <div>
        <span>EXEC_COMMAND</span><i>◆</i><span>WRITE_STDIN</span><i>◆</i><span>APPLY_PATCH</span><i>◆</i>
        <span>SECURE MCP TUNNEL</span><i>◆</i><span>LIVEBOARD</span><i>◆</i><span>DURABLE HISTORY</span><i>◆</i>
        <span>EXEC_COMMAND</span><i>◆</i><span>WRITE_STDIN</span><i>◆</i><span>APPLY_PATCH</span><i>◆</i>
        <span>SECURE MCP TUNNEL</span><i>◆</i><span>LIVEBOARD</span><i>◆</i><span>DURABLE HISTORY</span><i>◆</i>
      </div>
    </div>

    <section class="z-section z-quick shell" id="quick-start">
      <header class="z-section__head">
        <div>
          <p class="z-overline">Local / Daily use</p>
          <h2>Set up once.<br /><em>Then use the menu bar.</em></h2>
        </div>
        <div class="z-section__intro">
          <p>
            Zodex installs a tiny native Swift menu app by default. It launches when you log in, but Local itself stays stopped until you choose <strong>Start Zodex</strong>. Normal daily use needs no terminal.
          </p>
          <a class="text-link" href="/docs/local/setup">One-time setup guide <span aria-hidden="true">↗</span></a>
        </div>
      </header>

      <div class="menubar-flow">
        <figure class="menubar-shot" aria-label="Zodex native macOS menu bar controls">
          <div class="menubar-shot__bar"><span>ZDX / macOS</span><span>native Swift</span></div>
          <div class="menubar-shot__canvas">
            <div class="native-menu">
              <div class="native-menu__row native-menu__row--muted"><span class="native-menu__icon">▶</span><strong>Zodex is Running</strong></div>
              <div class="native-menu__row"><span class="native-menu__icon">■</span><strong>Stop Zodex</strong></div>
              <div class="native-menu__row"><span class="native-menu__icon">↗</span><strong>Open Liveboard</strong></div>
              <div class="native-menu__rule"></div>
              <div class="native-menu__row native-menu__row--muted"><span class="native-menu__icon">▰</span><strong>Start Folder: ~/code/my-project</strong></div>
              <div class="native-menu__row"><span class="native-menu__icon">▰</span><strong>Change Start Folder…</strong></div>
              <div class="native-menu__rule"></div>
              <div class="native-menu__row"><strong>Check for Updates…</strong></div>
              <div class="native-menu__row"><span class="native-menu__check">✓</span><strong>Launch at Login</strong></div>
              <div class="native-menu__row native-menu__row--muted"><strong>Zodex v0.3.9</strong></div>
              <div class="native-menu__rule"></div>
              <div class="native-menu__row"><strong>Quit</strong></div>
            </div>
          </div>
          <figcaption>Menu app starts at login. Local does not.</figcaption>
        </figure>

        <div class="menubar-steps">
          <article><span>01</span><div><strong>Log in</strong><p>The Zodex menu app appears automatically. Local is still off.</p></div></article>
          <article><span>02</span><div><strong>Choose your start folder</strong><p>Set it once, or switch it whenever you want ChatGPT to begin somewhere else.</p></div></article>
          <article><span>03</span><div><strong>Start Zodex</strong><p>One click brings Local and the Secure MCP Tunnel online.</p></div></article>
          <article><span>04</span><div><strong>Open ChatGPT</strong><p>Use one or many conversations against the same Local runtime.</p></div></article>
          <article><span>05</span><div><strong>Open Liveboard</strong><p>Watch commands, output, diffs, and processes beside the work.</p></div></article>
          <article><span>06</span><div><strong>Stop when done</strong><p>One click closes Local access. The menu app can remain ready for next time.</p></div></article>
        </div>
      </div>

      <div class="setup-once">
        <div>
          <p class="z-overline">First time only</p>
          <h3>Install + connect the tunnel.</h3>
          <p>Initial setup is still done once from Terminal. After that, start, stop, Liveboard, folder selection, updates, and launch-at-login all live in the menu bar.</p>
        </div>
        <div class="code-window">
          <div class="code-window__bar">
            <span>one-time setup</span>
            <button class="copy-button" type="button" data-copy-code aria-label="Copy Zodex Local setup"><span data-copy-label>copy</span></button>
          </div>
          <pre><code>{`# macOS
curl -fsSL https://zodex.ashray.xyz/install.sh | bash

# Windows PowerShell
irm https://zodex.ashray.xyz/install.ps1 | iex

zodex local setup`}</code></pre>
        </div>
      </div>
    </section>

    <section class="z-section z-local shell">
      <header class="z-section__head z-section__head--wide">
        <div>
          <p class="z-overline">Local / Built for actual work</p>
          <h2>Your environment.<br /><em>Now agent-native.</em></h2>
        </div>
        <p class="z-section__measure">
          Local is intentionally not a sandbox. ChatGPT gets the development environment you already trust, while Zodex adds lifecycle, attribution, observation, and durable evidence around it.
        </p>
      </header>

      <div class="feature-grid">
        {localFeatures.map((feature) => (
          <article class="feature-card">
            <div class="feature-card__top"><span>{feature.index}</span><span>{feature.marker}</span></div>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))}
      </div>

      <div class="trust-note">
        <span>TRUST MODEL</span>
        <p>
          Local runs as your logged-in host user. It can generally do what that user can do. The start folder is guidance, <em>not a filesystem boundary</em>, and normal host permissions remain authoritative.
        </p>
        <a class="text-link" href="/docs/local#the-local-trust-model">Understand Local security <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="z-section z-tools shell">
      <header class="z-section__head">
        <div>
          <p class="z-overline">Model interface / Deliberately tiny</p>
          <h2>Three tools.<br /><em>That is the product API.</em></h2>
        </div>
        <div class="z-section__intro">
          <p>
            Zodex keeps the model-facing surface boring on purpose. The runtime handles PTYs, process lifecycle, transport, observation, and host-specific security underneath familiar primitives.
          </p>
          <a class="text-link" href="/docs/reference/tools">Read the tool contract <span aria-hidden="true">↗</span></a>
        </div>
      </header>

      <div class="tool-grid">
        {tools.map((tool) => (
          <article class="tool-card">
            <div class="tool-card__top"><span>{tool.index}</span><span>{tool.verb}</span></div>
            <h3>{tool.name}</h3>
            <p>{tool.body}</p>
            <span class="tool-card__arrow" aria-hidden="true">↘</span>
          </article>
        ))}
      </div>
    </section>

    <section class="z-section z-modes shell">
      <header class="z-section__head">
        <div>
          <p class="z-overline">Beyond Local / Same agent interface</p>
          <h2>Two hosts.<br /><em>Two trust models.</em></h2>
        </div>
        <div class="z-section__intro">
          <p>
            Local is the direct path to the Linux, macOS, or Windows machine you already use. Sprite is the isolated remote path. ChatGPT sees the same three tools either way.
          </p>
          <a class="text-link" href="/docs/reference/architecture">Compare architecture <span aria-hidden="true">↗</span></a>
        </div>
      </header>

      <div class="mode-grid">
        {modes.map((mode) => (
          <a class="mode-card" href={mode.href}>
            <div class="mode-card__index">{mode.index}</div>
            <div class="mode-card__head"><h3>{mode.title}</h3><span>{mode.subtitle}</span></div>
            <p>{mode.body}</p>
            <ul>{mode.facts.map((fact) => <li>{fact}</li>)}</ul>
            <span class="mode-card__cta">Open {mode.title} <i aria-hidden="true">↗</i></span>
          </a>
        ))}
      </div>
    </section>

    <section class="z-section z-guides shell">
      <header class="z-section__head">
        <div>
          <p class="z-overline">Docs / Go deeper</p>
          <h2>Everything else<br /><em>is documented.</em></h2>
        </div>
        <div class="z-section__intro">
          <p>Setup, operating details, security boundaries, APIs, and implementation references live in the docs—not hidden behind product magic.</p>
          <a class="text-link" href="/docs">Browse all docs <span aria-hidden="true">↗</span></a>
        </div>
      </header>

      <div class="guide-list">
        {docsLinks.map(([index, title, href, body]) => (
          <a class="guide-row" href={href} target={href.startsWith("http") ? "_blank" : undefined} rel={href.startsWith("http") ? "noreferrer" : undefined}>
            <span class="guide-row__index">{index}</span>
            <h3>{title}</h3>
            <p>{body}</p>
            <span class="guide-row__arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="z-final shell">
      <div class="z-final__signal" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
      <p class="z-overline">ZODEX LOCAL / READY</p>
      <h2>Put ChatGPT on<br />your machine.</h2>
      <p>A real shell. Your real tools. Three familiar MCP primitives. Every action visible.</p>
      <div class="z-final__actions">
        <a class="z-button z-button--signal" href="/docs/local">Set up Local <span aria-hidden="true">↗</span></a>
        <a class="z-button z-button--inverse" href="/docs">Read the docs <span aria-hidden="true">→</span></a>
        <a class="z-button z-button--inverse" href="https://github.com/amxv/zodex" target="_blank" rel="noreferrer">View source <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>

  <script>
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-code]")) {
      button.addEventListener("click", async () => {
        const code = button.closest(".code-window")?.querySelector("pre code")?.textContent;
        const label = button.querySelector<HTMLElement>("[data-copy-label]");
        if (!code || !label) return;
        try {
          await navigator.clipboard.writeText(code);
          label.textContent = "copied";
          window.setTimeout(() => { label.textContent = "copy"; }, 1600);
        } catch {
          label.textContent = "select";
        }
      });
    }
  </script>
</BaseLayout>
